{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": [
        "src/modules/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/app"
                ],
                "message": "app/ composes; nothing composes app/. Move the shared piece down."
              },
              {
                "group": [
                  "@/modules/*"
                ],
                "message": "Modules never import each other. Put the shared vocabulary in domain/."
              },
              {
                "group": [
                  "@/server/*"
                ],
                "message": "server-only. Reachable from route handlers and server components, not from a client module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/modules/**",
        "src/app/**",
        "src/domain/**",
        "src/server/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/app"
                ],
                "message": "app/ composes; nothing composes app/. Move the shared piece down."
              },
              {
                "group": [
                  "@/modules/*"
                ],
                "message": "Nothing below modules/ imports a module. Move the shared piece down into services/ or domain/."
              },
              {
                "group": [
                  "@/server/*"
                ],
                "message": "server-only. Reachable from route handlers and server components, not from a client module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/server/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/app"
                ],
                "message": "app/ composes; nothing composes app/. Move the shared piece down."
              },
              {
                "group": [
                  "@/modules/*"
                ],
                "message": "Nothing below modules/ imports a module. Move the shared piece down into services/ or domain/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/domain/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/modules/*",
                  "@/app/*",
                  "@/app",
                  "@/server/*",
                  "@/components/*"
                ],
                "message": "domain/ is the bottom of the import graph. It must not import upward."
              }
            ]
          }
        ]
      }
    }
  ]
}
